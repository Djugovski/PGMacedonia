{
  "name": "pgmacedonia",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,app -c blue,green \"npm run dev:api\" \"npm run dev:app\"",
    "dev:app": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vue-tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "server": "tsx server/index.ts",
    "start": "node dist-server/index.cjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@unhead/vue": "^1.11.20",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "flag-icons": "^7.2.3",
    "nodemailer": "^6.9.16",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "sass": "^1.83.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-tsc": "^2.2.0"
  }
}
