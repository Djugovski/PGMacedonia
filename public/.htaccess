# PG Macedonia — SPA (Vue Router) + static cache headers for LiteSpeed / Apache.
# This file is copied by Vite into the production build (dist/).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (the cert is already there — make sure everyone uses it).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never rewrite /api/* — that must pass through to the Node backend
  # (cPanel "Setup Node.js App" or any reverse proxy you configure).
  RewriteRule ^api/ - [L]

  # Don't rewrite real files and directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a Vue Router path — serve the SPA shell.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ---------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed Vite assets — safe to cache forever.
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images — a week, updated occasionally.
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HTML must always be revalidated so deploys propagate instantly.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers (modest, don't break third-party widgets).
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Compression -----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- MIME (just in case) ---------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .mjs
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# LiteSpeed ships a `sitemap.xml` / `robots.txt` — nothing to do here.
