# --- API server (see server/index.ts) — copy to `.env` in project root for local dev ---
API_PORT=8787
CONTACT_TO_EMAIL=contact@pgmacedonia.com

# Public site URL used in approval emails (no trailing slash)
APP_PUBLIC_URL=http://localhost:5173

# Path prefix under which API routes are mounted. Default `/api` works everywhere.
# Set to `/` when running behind a proxy that already strips `/api` (e.g. cPanel's
# Phusion Passenger with Application URL configured as `/api`).
# API_PATH_PREFIX=/api

# Persistent file for the booking calendar. Default resolves to
# `<cwd>/server/data/calendar.json`. Point this at a mounted disk on production
# hosts (Render disk, Fly volume, cPanel home dir, Docker volume, …).
# CALENDAR_DATA_FILE=/var/data/calendar.json

# When running behind a reverse proxy / CDN in production (Nginx, Cloudflare,
# Render, Fly, etc.), set this to `true` so rate limiting can see the real
# client IP via X-Forwarded-For instead of the proxy's IP.
TRUST_PROXY=false

# Additional comma-separated CORS origins beyond pgmacedonia.mk + localhost.
# Example: EXTRA_CORS_ORIGINS=https://staging.pgmacedonia.mk,https://preview.example.com
EXTRA_CORS_ORIGINS=

# --- SMTP (email delivery) ---
# Without these, the API logs email bodies to the console instead of sending.
# For production we recommend a transactional provider with DKIM for pgmacedonia.mk:
#   Resend:  SMTP_HOST=smtp.resend.com       SMTP_PORT=465   SMTP_USER=resend   SMTP_PASS=<api key>
#   Brevo:   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587   SMTP_USER=<login>  SMTP_PASS=<smtp key>
#   Gmail:   SMTP_HOST=smtp.gmail.com        SMTP_PORT=465   SMTP_USER=<addr>   SMTP_PASS=<16-char app password>
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=contact@pgmacedonia.com
SMTP_PASS=
SMTP_FROM=contact@pgmacedonia.com

# --- Captcha ---
# The site uses a self-contained math captcha (no third-party dependency).
# No keys are required. See server/captcha.ts for the verification logic.

# Optional: protect POST /api/calendar/admin (set unavailable dates, add confirmed blocks)
# The same secret lets you force-refresh the gallery cache via
#   curl -X POST -H "x-calendar-admin-secret: <value>" https://pgmacedonia.mk/api/gallery/refresh
CALENDAR_ADMIN_SECRET=

# --- Nextcloud-powered gallery (cloud.pgmacedonia.mk) -------------------
# Paste the full public-share URL you see in the browser (with or without
# /index.php/). The backend will list files via WebDAV and expose them as
# `GET /api/gallery`. Results are cached 5 minutes so hitting the endpoint
# is cheap; drop a new file into the Nextcloud folder and it appears on
# the live site within the TTL — no redeploy.
# NEXTCLOUD_SHARE_URL=https://cloud.pgmacedonia.mk/index.php/s/cn7oiJRHpZoBfmr
# Only needed if the share is password-protected:
# NEXTCLOUD_SHARE_PASSWORD=

# --- Frontend (Vite) ---
# Override contact/calendar API origin when the SPA is not served with the API (production).
# VITE_API_URL=https://api.pgmacedonia.mk

# Optional: CDN / alternate base for gallery images. Defaults to `/gallery`
# (served from the SPA's public folder). Only set this if you move the
# gallery behind a CDN.
# VITE_GALLERY_BASE_URL=https://cdn.pgmacedonia.mk/gallery

# Optional: absolute URL for Open Graph / Twitter cards + JSON-LD image
# VITE_OG_IMAGE_URL=https://pgmacedonia.mk/wp-content/uploads/2024/hero.jpg
