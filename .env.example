# --- API server (see server/index.ts) — copy to `.env` in project root for local dev ---
API_PORT=8787
CONTACT_TO_EMAIL=dorian_dzugovski@live.com
# Public site URL used in approval emails (no trailing slash)
APP_PUBLIC_URL=http://localhost:5173

# Optional: Outlook / Microsoft 365 SMTP (use an app password if 2FA is on)
# Without these, the API logs email bodies to the console instead of sending.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=dorian_dzugovski@live.com
SMTP_PASS=
SMTP_FROM=dorian_dzugovski@live.com

# Optional: protect POST /api/calendar/admin (set unavailable dates, add confirmed blocks)
CALENDAR_ADMIN_SECRET=

# --- Frontend (Vite) ---
# Override contact/calendar API origin when the SPA is not served with the API (production).
# VITE_API_URL=https://api.pgmacedonia.mk

# Optional: WordPress uploads base for gallery paths
# VITE_GALLERY_BASE_URL=https://pgmacedonia.mk/wp-content/uploads

# Optional: absolute URL for Open Graph / Twitter cards + JSON-LD image
# VITE_OG_IMAGE_URL=https://pgmacedonia.mk/wp-content/uploads/2024/hero.jpg
